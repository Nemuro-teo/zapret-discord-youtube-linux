case "$1" in
    status) cmd_status ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    list) cmd_list ;;
    switch) cmd_switch "$2" ;;
    test) cmd_test "$2" ;;
    diag) cmd_diag ;;
    ipv6) cmd_ipv6 "$2" ;;
    game-filter) cmd_game_filter ;;
    update-lists) cmd_update_lists ;;
    log) cmd_log ;;
    uninstall) cmd_uninstall "$2" ;;
    help|--help|-h|"") cmd_help ;;
    *)
        echo -e "${RED}[!] Неизвестная команда: $1${NC}"
        cmd_help
        exit 1
        ;;
esac

