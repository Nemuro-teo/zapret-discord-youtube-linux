#!/bin/bash
# zapret-cli - утилита управления zapret-discord-youtube-linux

BASE_DIR="/opt/zapret-linux"
STRATEGY_DIR="$BASE_DIR/strategies"
CURRENT_STRATEGY="$BASE_DIR/current_strategy.conf"
GAME_FILTER_FILE="$BASE_DIR/.game_filter"
SERVICE_NAME="zapret-linux"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}[!] Для выполнения этой команды требуются права root (sudo).${NC}" >&2
        exit 1
    fi
}

get_current_strategy_name() {
    if [ -f "$CURRENT_STRATEGY" ]; then
        name=$(grep '^STRATEGY_NAME=' "$CURRENT_STRATEGY" 2>/dev/null | cut -d'"' -f2)
        if [ -n "$name" ]; then
            echo "$name"
            return
        fi
    fi
    echo "Не задана"
}

get_game_filter_status() {
    if [ -f "$GAME_FILTER_FILE" ]; then
        mode=$(cat "$GAME_FILTER_FILE" 2>/dev/null | tr -d ' \t\r\n')
        case "$mode" in
            tcp) echo "Включен (только TCP)" ;;
            udp) echo "Включен (только UDP)" ;;
            all|*) echo "Включен (TCP + UDP)" ;;
        esac
    else
        echo "Отключен"
    fi
}

cmd_status() {
    echo -e "${BOLD}=== zapret-discord-youtube-linux ===${NC}"
    echo -e "Активная стратегия : ${CYAN}$(get_current_strategy_name)${NC}"
    echo -e "Игровой фильтр     : ${YELLOW}$(get_game_filter_status)${NC}"
    echo
    systemctl status "$SERVICE_NAME" --no-pager
}

cmd_start() {
    check_root
    echo -e "Запуск службы ${CYAN}$SERVICE_NAME${NC}..."
    systemctl start "$SERVICE_NAME"
    cmd_status
}

cmd_stop() {
    check_root
    echo -e "Остановка службы ${CYAN}$SERVICE_NAME${NC}..."
    systemctl stop "$SERVICE_NAME"
    "$BASE_DIR/scripts/zapret-stop.sh" 2>/dev/null
    echo -e "${GREEN}Служба остановлена, правила фаервола очищены.${NC}"
}

cmd_restart() {
    check_root
    echo -e "Перезапуск службы ${CYAN}$SERVICE_NAME${NC}..."
    systemctl restart "$SERVICE_NAME"
    cmd_status
}

cmd_list() {
    echo -e "${BOLD}Доступные стратегии обхода Flowseal:${NC}"
    cur_name=$(get_current_strategy_name)
    idx=1
    for f in "$STRATEGY_DIR"/*.conf; do
        [ -f "$f" ] || continue
        sname=$(grep '^STRATEGY_NAME=' "$f" 2>/dev/null | cut -d'"' -f2)
        fname=$(basename "$f" .conf)
        if [ "$sname" = "$cur_name" ]; then
            printf "  ${GREEN}%2d) %-35s [АКТИВНА]${NC}\n" "$idx" "$sname"
        else
            printf "  %2d) %-35s (%s)\n" "$idx" "$sname" "$fname"
        fi
        idx=$((idx + 1))
    done
}

apply_strategy_file() {
    target_conf="$1"
    if [ ! -f "$target_conf" ]; then
        echo -e "${RED}[!] Файл стратегии не найден: $target_conf${NC}" >&2
        return 1
    fi
    cp "$target_conf" "$CURRENT_STRATEGY"
    sname=$(grep '^STRATEGY_NAME=' "$CURRENT_STRATEGY" 2>/dev/null | cut -d'"' -f2)
    echo -e "${GREEN}[✓] Установлена стратегия: ${BOLD}$sname${NC}"
    echo -e "Перезапуск службы..."
    systemctl restart "$SERVICE_NAME"
    sleep 1
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}[✓] Служба успешно перезапущена и работает!${NC}"
    else
        echo -e "${RED}[!] Внимание: служба не смогла запуститься. Проверьте: zapret-cli log${NC}"
    fi
}

cmd_switch() {
    check_root
    arg="$1"
    
    # Если передан аргумент (название или номер)
    if [ -n "$arg" ]; then
        # Проверяем как имя файла
        if [ -f "$STRATEGY_DIR/$arg.conf" ]; then
            apply_strategy_file "$STRATEGY_DIR/$arg.conf"
            return
        elif [ -f "$STRATEGY_DIR/$arg" ]; then
            apply_strategy_file "$STRATEGY_DIR/$arg"
            return
        fi
        
        # Проверяем как номер
        if [[ "$arg" =~ ^[0-9]+$ ]]; then
            idx=1
            for f in "$STRATEGY_DIR"/*.conf; do
                if [ "$idx" -eq "$arg" ]; then
                    apply_strategy_file "$f"
                    return
                fi
                idx=$((idx + 1))
            done
        fi
        
        # Проверяем неполное совпадение
        match=$(ls "$STRATEGY_DIR"/*"$arg"*.conf 2>/dev/null | head -n 1)
        if [ -n "$match" ] && [ -f "$match" ]; then
            apply_strategy_file "$match"
            return
        fi
        
        echo -e "${RED}[!] Стратегия '$arg' не найдена.${NC}" >&2
        exit 1
    fi
    
    # Интерактивное меню выбора
    echo -e "${BOLD}Выберите стратегию для активации:${NC}"
    echo
    files=("$STRATEGY_DIR"/*.conf)
    cur_name=$(get_current_strategy_name)
    
    for i in "${!files[@]}"; do
        f="${files[$i]}"
        sname=$(grep '^STRATEGY_NAME=' "$f" 2>/dev/null | cut -d'"' -f2)
        num=$((i + 1))
        if [ "$sname" = "$cur_name" ]; then
            printf "  ${GREEN}%2d) %-35s [АКТИВНА]${NC}\n" "$num" "$sname"
        else
            printf "  %2d) %-35s\n" "$num" "$sname"
        fi
    done
    echo "   0) Отмена"
    echo
    read -rp "Введите номер стратегии (0-${#files[@]}): " choice
    
    if [ "$choice" = "0" ] || [ -z "$choice" ]; then
        echo "Отмена."
        return
    fi
    
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#files[@]}" ]; then
        selected="${files[$((choice - 1))]}"
        apply_strategy_file "$selected"
    else
        echo -e "${RED}[!] Неверный выбор.${NC}"
    fi
}

cmd_game_filter() {
    check_root
    echo -e "${BOLD}=== Настройка Game Filter (Игровой фильтр) ===${NC}"
    echo -e "Текущий статус: ${YELLOW}$(get_game_filter_status)${NC}"
    echo
    echo "1. Отключить фильтр"
    echo "2. Включить (TCP + UDP)"
    echo "3. Включить только TCP"
    echo "4. Включить только UDP"
    echo "0. Отмена"
    echo
    read -rp "Выберите режим (0-4): " choice
    case "$choice" in
        1)
            rm -f "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр отключен.${NC}"
            ;;
        2)
            echo "all" > "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр включен для TCP и UDP.${NC}"
            ;;
        3)
            echo "tcp" > "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр включен только для TCP.${NC}"
            ;;
        4)
            echo "udp" > "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр включен только для UDP.${NC}"
            ;;
        0|*)
            echo "Отмена."
            return
            ;;
    esac
    echo "Перезапуск службы..."
    systemctl restart "$SERVICE_NAME"
}

cmd_update_lists() {
    check_root
    echo -e "${BOLD}Обновление списков IP и доменов из репозитория Flowseal...${NC}"
    mkdir -p "$BASE_DIR/lists"
    
    echo "Скачивание актуального ipset-all.txt (IP-адреса Discord, YouTube и Cloudflare)..."
    if wget -q -O "$BASE_DIR/lists/ipset-all.txt" "https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/refs/heads/main/.service/ipset-service.txt"; then
        echo -e "${GREEN}[✓] ipset-all.txt обновлен.${NC}"
    else
        echo -e "${RED}[!] Не удалось скачать ipset-service.txt.${NC}"
    fi
    
    for f in list-general.txt list-google.txt list-exclude.txt; do
        echo "Скачивание $f..."
        wget -q -N -P "$BASE_DIR/lists/" "https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/refs/heads/main/lists/$f"
    done
    
    # Права доступа
    chmod 644 "$BASE_DIR/lists/"*.txt 2>/dev/null
    
    echo -e "${GREEN}[✓] Списки успешно обновлены.${NC}"
    echo "Перезапуск службы..."
    systemctl restart "$SERVICE_NAME"
}

cmd_log() {
    journalctl -u "$SERVICE_NAME" -f
}

cmd_help() {
    echo -e "${BOLD}Утилита управления zapret-discord-youtube-linux${NC}"
    echo
    echo "Использование: zapret-cli <команда> [параметры]"
    echo
    echo "Команды:"
    echo "  status               Показать текущий статус службы и активную стратегию"
    echo "  list                 Показать список всех 22 стратегий Flowseal"
    echo "  switch [имя|номер]   Сменить стратегию (меню или прямой выбор)"
    echo "  start                Запустить службу"
    echo "  stop                 Остановить службу и сбросить фаервол"
    echo "  restart              Перезапустить службу"
    echo "  game-filter          Настройка игрового фильтра (порты игр 1024-65535)"
    echo "  update-lists         Скачать свежие списки IP и доменов от Flowseal"
    echo "  log                  Смотреть журнал работы службы в реальном времени"
    echo "  help                 Показать это сообщение"
    echo
    echo "Примеры:"
    echo "  sudo zapret-cli switch           # Открыть меню выбора"
    echo "  sudo zapret-cli switch alt13     # Быстро включить ALT13"
    echo "  sudo zapret-cli switch alt12     # Быстро включить ALT12"
}

case "$1" in
    status) cmd_status ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    list) cmd_list ;;
    switch) cmd_switch "$2" ;;
    game-filter) cmd_game_filter ;;
    update-lists) cmd_update_lists ;;
    log) cmd_log ;;
    help|--help|-h|"") cmd_help ;;
    *)
        echo -e "${RED}[!] Неизвестная команда: $1${NC}"
        cmd_help
        exit 1
        ;;
esac
