#!/bin/bash
# zapret-cli - утилита управления zapret-discord-youtube-linux

BASE_DIR="/opt/zapret-linux"
STRATEGY_DIR="$BASE_DIR/strategies"
CURRENT_STRATEGY="$BASE_DIR/current_strategy.conf"
GAME_FILTER_FILE="$BASE_DIR/.game_filter"
SERVICE_NAME="zapret-linux"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}[!] Для выполнения этой команды требуются права root (sudo).${NC}" >&2
        exit 1
    fi
}

get_current_strategy_name() {
    if [ -f "$CURRENT_STRATEGY" ]; then
        name=$(grep '^STRATEGY_NAME=' "$CURRENT_STRATEGY" 2>/dev/null | cut -d'"' -f2)
        if [ -n "$name" ]; then
            echo "$name"
            return
        fi
    fi
    echo "Не задана"
}

get_game_filter_status() {
    if [ -f "$GAME_FILTER_FILE" ]; then
        mode=$(cat "$GAME_FILTER_FILE" 2>/dev/null | tr -d ' \t\r\n')
        case "$mode" in
            tcp) echo "Включен (только TCP)" ;;
            udp) echo "Включен (только UDP)" ;;
            all|*) echo "Включен (TCP + UDP)" ;;
        esac
    else
        echo "Отключен"
    fi
}

cmd_status() {
    echo -e "${BOLD}=== zapret-discord-youtube-linux ===${NC}"
    echo -e "Активная стратегия : ${CYAN}$(get_current_strategy_name)${NC}"
    echo -e "Игровой фильтр     : ${YELLOW}$(get_game_filter_status)${NC}"
    val=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null || echo "0")
    if [ "$val" = "1" ]; then
        echo -e "Протокол IPv6      : ${YELLOW}Отключен в ОС (принудительный IPv4)${NC}"
    else
        echo -e "Протокол IPv6      : ${GREEN}Включен (dual-stack)${NC}"
    fi
    echo
    systemctl status "$SERVICE_NAME" --no-pager
}

cmd_start() {
    check_root
    echo -e "Запуск службы ${CYAN}$SERVICE_NAME${NC}..."
    systemctl start "$SERVICE_NAME"
    cmd_status
}

cmd_stop() {
    check_root
    echo -e "Остановка службы ${CYAN}$SERVICE_NAME${NC}..."
    systemctl stop "$SERVICE_NAME"
    "$BASE_DIR/scripts/zapret-stop.sh" 2>/dev/null
    echo -e "${GREEN}Служба остановлена, правила фаервола очищены.${NC}"
}

cmd_restart() {
    check_root
    echo -e "Перезапуск службы ${CYAN}$SERVICE_NAME${NC}..."
    systemctl restart "$SERVICE_NAME"
    cmd_status
}

cmd_list() {
    echo -e "${BOLD}Доступные стратегии обхода Flowseal:${NC}"
    cur_name=$(get_current_strategy_name)
    idx=1
    for f in "$STRATEGY_DIR"/*.conf; do
        [ -f "$f" ] || continue
        sname=$(grep '^STRATEGY_NAME=' "$f" 2>/dev/null | cut -d'"' -f2)
        fname=$(basename "$f" .conf)
        if [ "$sname" = "$cur_name" ]; then
            printf "  ${GREEN}%2d) %-35s [АКТИВНА]${NC}\n" "$idx" "$sname"
        else
            printf "  %2d) %-35s (%s)\n" "$idx" "$sname" "$fname"
        fi
        idx=$((idx + 1))
    done
}

apply_strategy_file() {
    target_conf="$1"
    if [ ! -f "$target_conf" ]; then
        echo -e "${RED}[!] Файл стратегии не найден: $target_conf${NC}" >&2
        return 1
    fi
    cp "$target_conf" "$CURRENT_STRATEGY"
    sname=$(grep '^STRATEGY_NAME=' "$CURRENT_STRATEGY" 2>/dev/null | cut -d'"' -f2)
    echo -e "${GREEN}[✓] Установлена стратегия: ${BOLD}$sname${NC}"
    echo -e "Перезапуск службы..."
    systemctl restart "$SERVICE_NAME"
    sleep 1
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}[✓] Служба успешно перезапущена и работает!${NC}"
    else
        echo -e "${RED}[!] Внимание: служба не смогла запуститься. Проверьте: zapret-cli log${NC}"
    fi
}

cmd_switch() {
    check_root
    arg="$1"
    
    # Если передан аргумент (название или номер)
    if [ -n "$arg" ]; then
        # Проверяем как имя файла
        if [ -f "$STRATEGY_DIR/$arg.conf" ]; then
            apply_strategy_file "$STRATEGY_DIR/$arg.conf"
            return
        elif [ -f "$STRATEGY_DIR/$arg" ]; then
            apply_strategy_file "$STRATEGY_DIR/$arg"
            return
        fi
        
        # Проверяем как номер
        if [[ "$arg" =~ ^[0-9]+$ ]]; then
            idx=1
            for f in "$STRATEGY_DIR"/*.conf; do
                if [ "$idx" -eq "$arg" ]; then
                    apply_strategy_file "$f"
                    return
                fi
                idx=$((idx + 1))
            done
        fi
        
        # Проверяем неполное совпадение
        match=$(ls "$STRATEGY_DIR"/*"$arg"*.conf 2>/dev/null | head -n 1)
        if [ -n "$match" ] && [ -f "$match" ]; then
            apply_strategy_file "$match"
            return
        fi
        
        echo -e "${RED}[!] Стратегия '$arg' не найдена.${NC}" >&2
        exit 1
    fi
    
    # Интерактивное меню выбора
    echo -e "${BOLD}Выберите стратегию для активации:${NC}"
    echo
    files=("$STRATEGY_DIR"/*.conf)
    cur_name=$(get_current_strategy_name)
    
    for i in "${!files[@]}"; do
        f="${files[$i]}"
        sname=$(grep '^STRATEGY_NAME=' "$f" 2>/dev/null | cut -d'"' -f2)
        num=$((i + 1))
        if [ "$sname" = "$cur_name" ]; then
            printf "  ${GREEN}%2d) %-35s [АКТИВНА]${NC}\n" "$num" "$sname"
        else
            printf "  %2d) %-35s\n" "$num" "$sname"
        fi
    done
    echo "   0) Отмена"
    echo
    read -rp "Введите номер стратегии (0-${#files[@]}): " choice
    
    if [ "$choice" = "0" ] || [ -z "$choice" ]; then
        echo "Отмена."
        return
    fi
    
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#files[@]}" ]; then
        selected="${files[$((choice - 1))]}"
        apply_strategy_file "$selected"
    else
        echo -e "${RED}[!] Неверный выбор.${NC}"
    fi
}

cmd_game_filter() {
    check_root
    echo -e "${BOLD}=== Настройка Game Filter (Игровой фильтр) ===${NC}"
    echo -e "Текущий статус: ${YELLOW}$(get_game_filter_status)${NC}"
    echo
    echo "1. Отключить фильтр"
    echo "2. Включить (TCP + UDP)"
    echo "3. Включить только TCP"
    echo "4. Включить только UDP"
    echo "0. Отмена"
    echo
    read -rp "Выберите режим (0-4): " choice
    case "$choice" in
        1)
            rm -f "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр отключен.${NC}"
            ;;
        2)
            echo "all" > "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр включен для TCP и UDP.${NC}"
            ;;
        3)
            echo "tcp" > "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр включен только для TCP.${NC}"
            ;;
        4)
            echo "udp" > "$GAME_FILTER_FILE"
            echo -e "${GREEN}[✓] Игровой фильтр включен только для UDP.${NC}"
            ;;
        0|*)
            echo "Отмена."
            return
            ;;
    esac
    echo "Перезапуск службы..."
    systemctl restart "$SERVICE_NAME"
}

cmd_update_lists() {
    check_root
    echo -e "${BOLD}Обновление списков IP и доменов из репозитория Flowseal...${NC}"
    mkdir -p "$BASE_DIR/lists"
    
    echo "Скачивание актуального ipset-all.txt (IP-адреса Discord, YouTube и Cloudflare)..."
    if wget -q -O "$BASE_DIR/lists/ipset-all.txt" "https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/refs/heads/main/.service/ipset-service.txt"; then
        echo -e "${GREEN}[✓] ipset-all.txt обновлен.${NC}"
    else
        echo -e "${RED}[!] Не удалось скачать ipset-service.txt.${NC}"
    fi
    
    for f in list-general.txt list-google.txt list-exclude.txt; do
        echo "Скачивание $f..."
        wget -q -N -P "$BASE_DIR/lists/" "https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/refs/heads/main/lists/$f"
    done
    
    # Права доступа
    chmod 644 "$BASE_DIR/lists/"*.txt 2>/dev/null
    
    echo -e "${GREEN}[✓] Списки успешно обновлены.${NC}"
    echo "Перезапуск службы..."
    systemctl restart "$SERVICE_NAME"
}

cmd_log() {
    journalctl -u "$SERVICE_NAME" -f
}

cmd_ipv6() {
    subcmd="$1"
    case "$subcmd" in
        off|disable)
            check_root
            echo "Отключение IPv6 в системе..."
            sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.lo.disable_ipv6=1 >/dev/null 2>&1
            cat << 'EOF' > /etc/sysctl.d/99-zapret-disable-ipv6.conf
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF
            echo -e "${GREEN}[✓] IPv6 успешно отключен (правило сохранено в /etc/sysctl.d/99-zapret-disable-ipv6.conf).${NC}"
            echo -e "${CYAN}Теперь все сетевые подключения (Discord, YouTube, браузеры) принудительно идут через чистый IPv4.${NC}"
            echo "Перезапуск службы $SERVICE_NAME..."
            systemctl restart "$SERVICE_NAME"
            ;;
        on|enable)
            check_root
            echo "Включение IPv6 в системе..."
            sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.default.disable_ipv6=0 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.lo.disable_ipv6=0 >/dev/null 2>&1
            rm -f /etc/sysctl.d/99-zapret-disable-ipv6.conf
            echo -e "${GREEN}[✓] IPv6 включен.${NC}"
            echo "Перезапуск службы $SERVICE_NAME..."
            systemctl restart "$SERVICE_NAME"
            ;;
        status|*)
            val=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null || echo "0")
            echo -e "${BOLD}=== Статус сетевого протокола IPv6 ===${NC}"
            if [ "$val" = "1" ]; then
                echo -e "Состояние          : ${YELLOW}ОТКЛЮЧЕН${NC} (весь сетевой трафик идет по IPv4)"
            else
                echo -e "Состояние          : ${GREEN}ВКЛЮЧЕН${NC} (dual-stack IPv4/IPv6)"
                has_g6=$(ip -6 addr show scope global 2>/dev/null | grep -m 1 "inet6")
                if [ -n "$has_g6" ]; then
                    echo -e "Глобальный адрес   : ${CYAN}Присутствует на сетевом интерфейсе${NC}"
                else
                    echo -e "Глобальный адрес   : ${YELLOW}Не обнаружен (IPv6 не настроен провайдером)${NC}"
                fi
            fi
            echo
            echo "Управление:"
            echo "  sudo zapret-cli ipv6 off   # Принудительно отключить IPv6 (решает блокировки Discord)"
            echo "  sudo zapret-cli ipv6 on    # Включить IPv6 обратно"
            ;;
    esac
}


test_endpoint() {
    local url="$1"
    local res
    res=$(curl -4 -s -k -m 4 -o /dev/null -w "%{http_code}:%{time_total}" "$url" 2>/dev/null)
    local code="${res%%:*}"
    local time="${res##*:}"
    if [ -n "$code" ] && [ "$code" != "000" ]; then
        echo "OK:$code:${time}s"
    else
        echo "FAIL:000:0.00s"
    fi
}

run_quick_probe() {
    local t_dir
    t_dir=$(mktemp -d)
    test_endpoint "https://discord.com" > "$t_dir/d1" &
    test_endpoint "https://www.youtube.com" > "$t_dir/y1" &
    wait
    
    local r_d1=$(cat "$t_dir/d1" 2>/dev/null)
    local r_y1=$(cat "$t_dir/y1" 2>/dev/null)
    rm -rf "$t_dir"

    local d_ok=0
    local y_ok=0
    [[ "$r_d1" == OK* ]] && d_ok=1
    [[ "$r_y1" == OK* ]] && y_ok=1

    echo "$d_ok:$y_ok:$r_d1:$r_y1"
}


cmd_test_current() {
    if ! command -v curl >/dev/null 2>&1; then
        echo -e "${RED}[!] curl не найден. Установите curl для проведения тестов.${NC}" >&2
        return 1
    fi

    cur_name=$(get_current_strategy_name)
    echo -e "${BOLD}Тестирование активной стратегии: ${CYAN}$cur_name${NC}"
    echo "Проверка доступности ключевых сервисов..."
    echo
    
    targets=(
        "https://discord.com"               "Discord Web"
        "https://gateway.discord.gg"        "Discord Gateway (Голос)"
        "https://cdn.discordapp.com"        "Discord CDN (Медиа/Файлы)"
        "https://www.youtube.com"           "YouTube Web"
        "https://redirector.googlevideo.com" "YouTube Video Stream"
        "https://www.google.com"            "Google (Контрольный)"
    )

    local ipv6_leak_detected=0
    local all_ok=1

    for ((i=0; i<${#targets[@]}; i+=2)); do
        url="${targets[$i]}"
        label="${targets[$((i+1))]}"
        
        printf "  %-32s : " "$label"
        res=$(test_endpoint "$url")
        if [[ "$res" == OK* ]]; then
            code=$(echo "$res" | cut -d: -f2)
            time=$(echo "$res" | cut -d: -f3)
            echo -e "${GREEN}✓ OK${NC} (HTTP $code, $time)"
        else
            all_ok=0
            echo -e "${RED}✗ FAIL${NC}"
            # Проверяем IPv4 fallback
            res4=$(test_endpoint "$url" "-4")
            if [[ "$res4" == OK* ]]; then
                ipv6_leak_detected=1
            fi
        fi
    done

    echo
    if [ "$all_ok" -eq 1 ]; then
        echo -e "${GREEN}${BOLD}[✓] Все сервисы работают отлично!${NC}"
    else
        echo -e "${YELLOW}${BOLD}[!] Некоторые сервисы недоступны.${NC}"
        if [ "$ipv6_leak_detected" -eq 1 ]; then
            echo -e "${RED}${BOLD}[!] ВНИМАНИЕ: Запросы по IPv4 работают, но по IPv6 блокируются!${NC}"
            echo -e "${YELLOW}Решение: отключите утечку IPv6 в системе командой:${NC} ${BOLD}sudo zapret-cli ipv6 off${NC}"
        else
            echo -e "Рекомендуется протестировать другие стратегии командой: ${BOLD}sudo zapret-cli test all${NC}"
        fi
    fi
}

cmd_test_all() {
    check_root
    if ! command -v curl >/dev/null 2>&1; then
        echo -e "${RED}[!] curl не найден. Установите curl для проведения тестов.${NC}" >&2
        return 1
    fi

    local subset="$1"
    local files=("$STRATEGY_DIR"/*.conf)
    if [ "${#files[@]}" -eq 0 ]; then
        echo -e "${RED}[!] Стратегии не найдены в $STRATEGY_DIR${NC}" >&2
        return 1
    fi
    
    local backup_strat
    backup_strat=$(mktemp)
    cp "$CURRENT_STRATEGY" "$backup_strat"
    local orig_name
    orig_name=$(get_current_strategy_name)
    
    cleanup_on_interrupt() {
        echo
        echo -e "${YELLOW}Тестирование прервано пользователем. Восстановление $orig_name...${NC}"
        cp "$backup_strat" "$CURRENT_STRATEGY"
        rm -f "$backup_strat"
        systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
        exit 1
    }
    trap cleanup_on_interrupt INT TERM
    
    echo -e "${BOLD}========================================================================${NC}"
    echo -e "${BOLD}       Автоматическое тестирование стратегий обхода Flowseal            ${NC}"
    echo -e "${BOLD}========================================================================${NC}"
    echo -e "Активная стратегия до теста : ${CYAN}$orig_name${NC}"
    echo "Тестирование (Discord Web/Gateway + YouTube Web/Video)..."
    echo
    printf "  %-3s %-30s | %-15s | %-15s | %-12s\n" "№" "Стратегия" "Discord" "YouTube" "Статус"
    echo "  ----------------------------------------------------------------------------"

    local working_files=()
    local working_names=()
    local idx=1
    
    for f in "${files[@]}"; do
        [ -f "$f" ] || continue
        fname=$(basename "$f" .conf)
        sname=$(grep '^STRATEGY_NAME=' "$f" 2>/dev/null | cut -d'"' -f2)
        
        if [ "$subset" = "quick" ]; then
            case "$fname" in
                general_alt13|general_alt12|general_alt11|general_alt|general_fake_tls_auto|general_simple_fake) ;;
                *) continue ;;
            esac
        fi
        
        cp "$f" "$CURRENT_STRATEGY"
        systemctl reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
        systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
        # Ожидание готовности nfqws и загрузки ipset списков в память
        sleep 2
        
        probe_res=$(run_quick_probe)
        d_ok=$(echo "$probe_res" | cut -d: -f1)
        y_ok=$(echo "$probe_res" | cut -d: -f2)
        r_d1=$(echo "$probe_res" | cut -d: -f3-5)
        r_y1=$(echo "$probe_res" | cut -d: -f6-8)
        
        d_time=$(echo "$r_d1" | cut -d: -f3)
        y_time=$(echo "$r_y1" | cut -d: -f3)

        if [ "$d_ok" -eq 1 ]; then
            d_str="${GREEN}✓ OK (${d_time})${NC}"
        else
            d_str="${RED}✗ FAIL      ${NC}"
        fi
        
        if [ "$y_ok" -eq 1 ]; then
            y_str="${GREEN}✓ OK (${y_time})${NC}"
        else
            y_str="${RED}✗ FAIL      ${NC}"
        fi
        
        if [ "$d_ok" -eq 1 ] && [ "$y_ok" -eq 1 ]; then
            status_str="${GREEN}${BOLD}РАБОТАЕТ${NC}  "
            working_files+=("$f")
            working_names+=("$sname [Discord + YouTube]")
        elif [ "$d_ok" -eq 1 ]; then
            status_str="${YELLOW}Discord OK${NC}"
            working_files+=("$f")
            working_names+=("$sname [только Discord]")
        elif [ "$y_ok" -eq 1 ]; then
            status_str="${YELLOW}YouTube OK${NC}"
            working_files+=("$f")
            working_names+=("$sname [только YouTube]")
        else
            status_str="${RED}НЕ РАБОТАЕТ${NC}"
        fi
        
        printf "  %02d) %-30s | %b | %b | %b\n" "$idx" "$sname" "$d_str" "$y_str" "$status_str"
        idx=$((idx + 1))
    done
    
    echo "  ----------------------------------------------------------------------------"
    echo
    echo -e "Подходящих стратегий найдено: ${GREEN}${BOLD}${#working_files[@]}${NC}"
    
    if [ ${#working_files[@]} -gt 0 ]; then
        echo -e "${GREEN}Список найденных вариантов:${NC}"
        for ((w=0; w<${#working_names[@]}; w++)); do
            echo -e "  $((w+1))) ${CYAN}${working_names[$w]}${NC}"
        done
        echo
        
        if [ -t 0 ]; then
            read -rp "Применить одну из работающих стратегий? Введите номер 1-${#working_files[@]} (или 0 для возврата '$orig_name'): " pick
            if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "${#working_files[@]}" ]; then
                chosen_f="${working_files[$((pick - 1))]}"
                chosen_n="${working_names[$((pick - 1))]}"
                cp "$chosen_f" "$CURRENT_STRATEGY"
                systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
                rm -f "$backup_strat"
                trap - INT TERM
                echo -e "${GREEN}[✓] Успешно сохранена и активна стратегия: ${BOLD}$chosen_n${NC}"
                return 0
            fi
        fi
    fi
    
    echo "Восстановление исходной стратегии: $orig_name..."
    cp "$backup_strat" "$CURRENT_STRATEGY"
    rm -f "$backup_strat"
    systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
    trap - INT TERM
    echo -e "${GREEN}[✓] Исходная стратегия восстановлена.${NC}"
}

cmd_test_single() {
    check_root
    arg="$1"
    match=""
    if [ -f "$STRATEGY_DIR/$arg.conf" ]; then
        match="$STRATEGY_DIR/$arg.conf"
    elif [ -f "$STRATEGY_DIR/$arg" ]; then
        match="$STRATEGY_DIR/$arg"
    else
        match=$(ls "$STRATEGY_DIR"/*"$arg"*.conf 2>/dev/null | head -n 1)
    fi
    
    if [ -z "$match" ] || [ ! -f "$match" ]; then
        echo -e "${RED}[!] Стратегия '$arg' не найдена.${NC}" >&2
        return 1
    fi
    
    backup_strat=$(mktemp)
    cp "$CURRENT_STRATEGY" "$backup_strat"
    orig_name=$(get_current_strategy_name)
    
    cleanup_single() {
        echo
        echo -e "${YELLOW}Тест прерван. Восстановление $orig_name...${NC}"
        cp "$backup_strat" "$CURRENT_STRATEGY"
        rm -f "$backup_strat"
        systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
        exit 1
    }
    trap cleanup_single INT TERM
    
    cp "$match" "$CURRENT_STRATEGY"
    systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
    sleep 1
    cmd_test_current
    
    if [ -t 0 ]; then
        echo
        read -rp "Оставить эту стратегию активной? [y/N]: " keep
        case "$keep" in
            y|Y|д|Д)
                rm -f "$backup_strat"
                trap - INT TERM
                echo -e "${GREEN}[✓] Стратегия сохранена.${NC}"
                return 0
                ;;
        esac
    fi
    
    echo "Восстановление исходной стратегии: $orig_name..."
    cp "$backup_strat" "$CURRENT_STRATEGY"
    rm -f "$backup_strat"
    systemctl restart "$SERVICE_NAME" >/dev/null 2>&1
    trap - INT TERM
}

cmd_test() {
    sub="$1"
    case "$sub" in
        all)
            cmd_test_all "all"
            ;;
        quick)
            cmd_test_all "quick"
            ;;
        current|"")
            cmd_test_current
            ;;
        *)
            cmd_test_single "$sub"
            ;;
    esac
}

cmd_diag() {
    check_root
    echo -e "${BOLD}======================================================${NC}"
    echo -e "${BOLD}       Комплексная диагностика системы и zapret       ${NC}"
    echo -e "${BOLD}======================================================${NC}"
    echo
    
    echo -e "${CYAN}[1] Служба systemd и процесс nfqws:${NC}"
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "  Служба $SERVICE_NAME : ${GREEN}ACTIVE (работает)${NC}"
    else
        echo -e "  Служба $SERVICE_NAME : ${RED}НЕ АКТИВНА / ОШИБКА${NC}"
    fi
    pid=$(pgrep -f "$BIN/nfqws" | head -n 1)
    if [ -n "$pid" ]; then
        echo -e "  Процесс nfqws        : ${GREEN}Работает (PID $pid)${NC}"
    else
        echo -e "  Процесс nfqws        : ${RED}НЕ ЗАПУЩЕН!${NC}"
    fi
    echo
    
    echo -e "${CYAN}[2] Параметры ядра Linux (sysctl):${NC}"
    ts=$(sysctl -n net.ipv4.tcp_timestamps 2>/dev/null)
    if [ "$ts" = "1" ]; then
        echo -e "  net.ipv4.tcp_timestamps       : ${GREEN}1 (включено, необходимо для fooling=ts)${NC}"
    else
        echo -e "  net.ipv4.tcp_timestamps       : ${RED}$ts (ОШИБКА! Должно быть 1)${NC}"
    fi
    ip6=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)
    if [ "$ip6" = "1" ]; then
        echo -e "  net.ipv6.conf.all.disable_ipv6: ${GREEN}1 (IPv6 отключен, нет утечек)${NC}"
    else
        echo -e "  net.ipv6.conf.all.disable_ipv6: ${YELLOW}0 (IPv6 включен, возможны утечки мимо desync)${NC}"
    fi
    echo
    
    echo -e "${CYAN}[3] Правила фаервола iptables (счетчики пакетов):${NC}"
    ipt_rules=$(iptables -S OUTPUT 2>/dev/null | grep "NFQUEUE")
    if [ -n "$ipt_rules" ]; then
        echo -e "${GREEN}  ✓ Правила перехвата NFQUEUE активны:${NC}"
        iptables -L OUTPUT -v -n 2>/dev/null | grep -E "NFQUEUE" | while read -r line; do
            echo "    $line"
        done
    else
        echo -e "${RED}  ✗ Правила перехвата в iptables отсутствуют!${NC}"
        echo "  Тестовая проверка добавления правила в фаервол..."
        test_err=$(iptables -I OUTPUT -p tcp --dport 443 -j NFQUEUE --queue-num 200 --queue-bypass 2>&1)
        res_code=$?
        if [ $res_code -ne 0 ]; then
            echo -e "  ${RED}Ошибка ядра при установке NFQUEUE:${NC} $test_err"
        else
            echo -e "  ${YELLOW}Тестовое правило успешно ставится вручную. Очистка теста...${NC}"
            iptables -D OUTPUT -p tcp --dport 443 -j NFQUEUE --queue-num 200 --queue-bypass 2>/dev/null
        fi
    fi
    echo
    
    echo -e "${CYAN}[4] Проверка DNS для discord.com:${NC}"
    dns_ip=$(getent ahostsv4 discord.com 2>/dev/null | awk '{print $1}' | head -n 1)
    if [ -n "$dns_ip" ]; then
        echo -e "  IPv4: ${GREEN}$dns_ip${NC}"
    else
        echo -e "  ${RED}Не удалось получить IPv4 для discord.com через DNS!${NC}"
    fi
    echo
    
    echo -e "${CYAN}[5] Тест TLS handshake (curl -4 -Iv https://discord.com):${NC}"
    curl_res=$(curl -4 -Iv -m 5 https://discord.com 2>&1)
    http_line=$(echo "$curl_res" | grep -E "^< HTTP/" | tail -n 1)
    ssl_err=$(echo "$curl_res" | grep -Ei "(alert|handshake|error|reset)" | head -n 2)
    if [ -n "$http_line" ]; then
        echo -e "  Статус: ${GREEN}УСПЕШНО ($http_line)${NC}"
    else
        echo -e "  Статус: ${RED}ОШИБКА ХЭНДШЕЙКА / СОЕДИНЕНИЯ${NC}"
        [ -n "$ssl_err" ] && echo -e "  Детали: ${YELLOW}$ssl_err${NC}"
    fi
    echo
    
    echo -e "${CYAN}[6] Последние строки журнала службы:${NC}"
    journalctl -u "$SERVICE_NAME" -n 8 --no-pager 2>/dev/null | sed 's/^/  /'
    echo
    echo -e "${BOLD}======================================================${NC}"
}

cmd_uninstall() {
    check_root
    if [ "$1" != "-y" ] && [ "$1" != "--yes" ]; then
        echo -e "${YELLOW}Вы действительно хотите полностью удалить zapret-discord-youtube-linux? (y/N)${NC}"
        read -r confirm
        case "$confirm" in
            y|Y|yes|Yes|да|Да) ;;
            *) echo "Удаление отменено."; return 0 ;;
        esac
    fi
    if [ -f "$BASE_DIR/uninstall.sh" ]; then
        bash "$BASE_DIR/uninstall.sh"
    elif [ -f "$(dirname "$0")/uninstall.sh" ]; then
        bash "$(dirname "$0")/uninstall.sh"
    else
        echo -e "${RED}[!] Файл uninstall.sh не найден!${NC}"
        exit 1
    fi
}

cmd_help() {
    echo -e "${BOLD}Утилита управления zapret-discord-youtube-linux${NC}"
    echo
    echo "Использование: zapret-cli <команда> [параметры]"
    echo
    echo "Команды управления стратегиями:"
    echo "  status               Показать текущий статус службы, стратегию и IPv6"
